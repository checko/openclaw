# OpenClaw Deployment Configuration Template
#
# This file configures the DEPLOYMENT INSTALLER (install.sh / uninstall.sh).
# It is NOT the application .env for API keys or gateway tokens.
# For application secrets (API keys, OPENCLAW_GATEWAY_TOKEN, etc.), see .env.example.
#
# Quick start:
# 1) Copy this file: cp deploy.env.example deploy.env
# 2) Edit deploy.env with your actual server IPs and tokens.
# 3) Run: ./install.sh

# The directory where OpenClaw will be installed.
INSTALL_DIR="${HOME}/openclaw-prod"

# The directory for the 'openclaw' CLI wrapper.
BIN_DIR="${HOME}/.local/bin"

# -----------------------------------------------------------------------------
# AI Model Configuration
# -----------------------------------------------------------------------------
# URL of your Ollama server.
OLLAMA_BASE_URL="http://192.168.1.100:11434"

# Ollama model ID to configure as the default.
QWEN_MODEL_ID="qwen3.5:122b"

# -----------------------------------------------------------------------------
# Search Provider Configuration
# -----------------------------------------------------------------------------
# URL of your SearXNG instance.
SEARXNG_BASE_URL="http://192.168.1.100:8081"

# -----------------------------------------------------------------------------
# Messaging / Channel Configuration
# -----------------------------------------------------------------------------
# Telegram Bot API token. Leave commented out to skip Telegram setup.
# TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
